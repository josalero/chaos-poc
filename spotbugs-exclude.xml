<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
  <!--
    Spring collaborators and record components are stored by design. SpotBugs treats every
    mutable field as an internal representation that must be copied.
  -->
  <Match>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
  </Match>
</FindBugsFilter>
